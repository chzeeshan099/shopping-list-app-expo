{
  "expo": {
    "name": "Shopping List App",
    "slug": "shopping-list-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/todo-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/todo-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.readyme.todoapp"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/todo-logo.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "8d36dce3-9e69-4244-86a9-6f5d396775f0"
      }
    },
    "owner": "readymes-team"
  }
}
